# Prod only. Mode 0600, owner grok-wechat. Do not commit a filled copy.
# OPENCLAW_GATEWAY_TOKEN is read by the local reply process and is never sent to the box.
PATH=/usr/bin:/bin
HOME=/var/lib/grok-wechat
USER=grok-wechat
OPENCLAW_STATE_DIR=/var/lib/grok-wechat/.openclaw
BRIDGE_DATA_DIR=/var/lib/grok-wechat/bridge-data
OPENCLAW_BIN=/usr/bin/openclaw
WECHAT_ACCOUNT_ID=
WECHAT_OWNER_ID=
OPENCLAW_GATEWAY_TOKEN=
